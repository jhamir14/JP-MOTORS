# Copia este archivo a .env.local y completa los valores.
# Las variables NEXT_PUBLIC_* se incluyen en el bundle del navegador (no poner secretos ahí).

# Sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000  # en producción: https://inversiones-jp.com (valor por defecto)

# WhatsApp de ventas (formato internacional, solo dígitos)
NEXT_PUBLIC_WHATSAPP_NUMBER=51902423015
# WhatsApp del asesor de cada área (cotizaciones y consultas de productos)
NEXT_PUBLIC_WHATSAPP_MOTOS=51902423015
NEXT_PUBLIC_WHATSAPP_CELULARES=51920694641

# Google Analytics 4 (vacío = desactivado)
NEXT_PUBLIC_GA_ID=G-C6RTDH3SXY

# Datos legales (Libro de Reclamaciones y páginas legales)
NEXT_PUBLIC_RUC=10479269217
NEXT_PUBLIC_EMAIL_CONTACTO=contacto@jpmotorshonda.com

# Las tasas de los simuladores y los planes de crédito ya NO van aquí:
# se administran en /admin/tasas y /admin/catalogo (tablas tasa_servicio y plan_credito).

# --- Solo servidor ---
# PostgreSQL en Railway: catálogo, tasas, solicitudes, Libro de Reclamaciones y panel /admin.
# Sin ella la web pública usa el catálogo de respaldo (src/data/catalogoRespaldo.ts) y el panel no funciona.
# En Vercel: la URL pública del servicio Postgres (variable DATABASE_PUBLIC_URL en Railway).
# Es una credencial con acceso total: solo en el servidor, nunca con prefijo NEXT_PUBLIC_.
DATABASE_URL=

# Correo que recibe un aviso de cada solicitud (vía formsubmit.co). Opcional si DATABASE_URL está configurada.
LEADS_EMAIL=contacto@jpmotorshonda.com

# Ruta secreta del panel (solo servidor). El login se abre en https://tu-dominio/<esta ruta> y /admin sin sesión
# responde 404. Solo letras, números, guiones; mínimo 8 caracteres y que no empiece con «admin».
# Sin esta variable, el login sigue en /admin/login.
PANEL_RUTA_SECRETA=

# Avisos de cobranza por notificación push (llegan aunque el panel esté cerrado).
# Vercel Cron llama a /api/cron/avisos-cobranza a las 8:00 y 15:00 (Lima) — ver vercel.json.
# CRON_SECRET: Vercel la envía sola en cada llamada; con ella nadie más puede disparar los avisos.
CRON_SECRET=
# Opcionales: si faltan, las claves VAPID se generan solas y se guardan en la base (tabla push_clave).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
