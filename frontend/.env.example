# Copia este archivo a .env.local y completa los valores.
# Las variables NEXT_PUBLIC_* se incluyen en el bundle del navegador (no poner secretos ahí).

# Sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp de ventas (formato internacional, solo dígitos)
NEXT_PUBLIC_WHATSAPP_NUMBER=51902423015

# Google Analytics 4 (vacío = desactivado)
NEXT_PUBLIC_GA_ID=G-C6RTDH3SXY

# Tasas referenciales de los simuladores (deben coincidir con la tabla tasa_servicio)
NEXT_PUBLIC_TASA_VEHICULAR_MENSUAL=0.02
NEXT_PUBLIC_TASA_CELULAR_SEMANAL=0.012

# --- Solo servidor ---
# Supabase: las solicitudes de la web se guardan en la tabla solicitud_credito.
# La service_role key salta el RLS: solo en el servidor (Vercel), nunca con prefijo NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Correo que recibe un aviso de cada solicitud (vía formsubmit.co). Opcional si Supabase está configurado.
LEADS_EMAIL=contacto@jpmotorshonda.com
